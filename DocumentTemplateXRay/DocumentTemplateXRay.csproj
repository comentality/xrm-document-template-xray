<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>DocumentTemplateXRay</AssemblyName>
    <RootNamespace>DocumentTemplateXRay</RootNamespace>
    <Version>1.2.20</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <Company>Comentality</Company>
    <Authors>Comentality</Authors>
    <Description>See every field, relationship and repeating section a Word document template uses, as a flat list or a tree. Reads the content controls inside a Dynamics 365 .docx template, so you don't have to click through them one at a time.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NuspecFile>DocumentTemplateXRay.nuspec</NuspecFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.7.71">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
